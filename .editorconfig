# Convenciones de formato del repositorio. Ver https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 120

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.sh]
indent_size = 4

[*.md]
# Markdown usa dos espacios finales como salto de línea forzado.
trim_trailing_whitespace = false

# Los ficheros de traducción son «clave=valor» por línea: sin sangría ni recortes
# que puedan alterar los valores.
[bauh/**/resources/locale/*]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false

[*.desktop]
indent_style = unset
indent_size = unset
